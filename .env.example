# AffectBridge configuration template.
#
# Copy to .env and edit. .env is gitignored.
# The Go server reads environment variables directly; load them
# before running the server, e.g.:
#
#   export $(grep -v '^#' .env | xargs)
#   go run ./cmd/server

# ─── HTTP server ──────────────────────────────────────────────
# Port the AffectBridge HTTP server listens on.
PORT=8080

# ─── ALMA affect engine ──────────────────────────────────────
# HTTP address of a running ALMA REST server. Setting this to
# something other than the default noop value switches the
# affect engine from noop to ALMA in api/routes.go.
ALMA_ADDR=http://localhost:8081

# Optional: path to the locally installed ALMA runtime.
# Informational; the server talks to ALMA over HTTP, not by
# reading this path.
# ALMA_HOME=/path/to/alma

# ─── LLM (pgEdge) ────────────────────────────────────────────
# Provider name: openai / anthropic / gemini / ollama / voyage.
LLM_PROVIDER=openai

# API key for the chosen provider. Required for real calls.
# Without it, the server falls back to NoopClient.
# LLM_API_KEY=

# Model id forwarded to the provider.
LLM_MODEL=gpt-4o-mini

# Optional base URL override for OpenAI-compatible proxies,
# self-hosted gateways, or local ollama.
# LLM_BASE_URL=

# Max in-flight LLM calls per provider. When the cap is reached
# the limiter returns ErrBusy instead of queueing. <= 0 disables
# the limit.
LLM_MAX_CONCURRENT=32

# Comma-separated fallback provider names. Empty = no fallback.
# All providers in the chain share the same LLM_API_KEY / model /
# base URL.
# LLM_FALLBACK=anthropic,ollama
